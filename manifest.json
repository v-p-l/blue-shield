{
  "manifest_version": 3,
  "name": "Blue Shield - anti-spoil YouTube",
  "version": "1.0.0",
  "description": "Masque la durée, la barre de progression et les commentaires des vidéos YouTube, chaîne par chaîne.",
  "permissions": ["storage"],
  "host_permissions": ["https://www.youtube.com/*"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Blue Shield",
    "default_icon": {
      "16": "icons/icon-16.png",
      "24": "icons/icon-24.png",
      "32": "icons/icon-32.png"
    },
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content/main-world.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["shared/i18n.js", "shared/dom.js", "shared/options.js", "content/content.js"],
      "css": ["content/blueshield.css"],
      "run_at": "document_start"
    }
  ]
}
